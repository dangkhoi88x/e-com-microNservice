# Copy this file to .env.dev and replace every placeholder with your local value.
# Never commit .env.dev or any private key.

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel
STRIPE_CURRENCY=vnd

# Service-to-service authentication
INTERNAL_PAYMENT_API_KEY=replace_with_a_long_random_value
PASSWORD_RESET_PEPPER=replace_with_a_long_random_value

# JWT signing (identity-service only; Base64-encoded PKCS#8 RSA private key)
JWT_RSA_PRIVATE_KEY=base64_encoded_rsa_private_key
JWT_RSA_KEY_ID=identity-key-1
JWT_ISSUER=identity-service
JWT_AUDIENCE=ecommerce-services
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# AWS S3 / media-service
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
BUCKET_NAME=your_s3_bucket_name
REGION=ap-southeast-1

# Local media database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5441/media_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_local_database_password
