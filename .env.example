# Stripe test mode. Never commit real sk_test/sk_live or whsec values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/shop/payment-result?status=success&paymentId={PAYMENT_ID}&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/shop/payment-result?status=cancel&paymentId={PAYMENT_ID}
STRIPE_CURRENCY=vnd

# Must be the same value in payment-service and order-service.
INTERNAL_PAYMENT_API_KEY=replace-with-a-long-random-value

# Base64-encoded PKCS#8 RSA private key. Keep it in a secret manager or .env.dev.
JWT_RSA_PRIVATE_
JWT_RSA_KEY_ID=identity-rs256-v1
JWT_ISSUER=http://localhost:8090
JWT_AUDIENCE=novashop-api
JWT_JWK_SET_URI=http://localhost:8090/identity/api/.well-known/jwks.json
PASSWORD_RESET_PEPPER=
