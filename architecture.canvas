    {
      "id": "fc471ce1ec61f8c7",
      "type": "text",
      "text": "**API Gateway** `:9191`\nSpring Cloud Gateway\n20 route · nguồn duy nhất trong Java",
      "x": 40,
      "y": 300,
      "width": 240,
      "height": 90,
      "color": "1"
    },
    {
      "id": "87854477ec578e95",
      "type": "text",
      "text": "**Identity** `:8090` · gRPC `:9090`\nKý JWT RS256 · JWKS\nRefresh token cookie",
      "x": 320,
      "y": 300,
      "width": 240,
      "height": 90,
      "color": "1"
    },
    {
      "id": "27eae1ff2508ae2e",
      "type": "text",
      "text": "**Eureka** `:8761`\nService discovery\n⚠ port quảng bá phải = port publish",
      "x": 600,
      "y": 300,
      "width": 240,
      "height": 90,
      "color": "5"
    },
    {
      "id": "cce55e4309a75398",
      "type": "text",
      "text": "**Order** `:8086`\nSaga checkout + bù trừ\n`OrderServiceImpl.createOrder`",
