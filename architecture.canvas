      "height": 90,
      "color": "3"
    },
    {
      "id": "a22c81f9e58d3e18",
      "type": "text",
      "text": "**Inventory** `:8087`\n**Nguồn sự thật tồn kho**\nreserve → confirm / release",
      "x": 600,
      "y": 560,
      "width": 240,
      "height": 90,
      "color": "3"
    },
    {
      "id": "bfc95e50f828f0ae",
      "type": "text",
      "text": "**Payment** `:8088`\nCOD + Stripe webhook\n1 pending / order (ràng buộc DB)",
