      "y": 560,
      "width": 240,
      "height": 90,
      "color": "2"
    },
    {
      "id": "8bfb4e1aa590eab8",
      "type": "text",
      "text": "**Cart** `:8089`\nKhoá item bằng `checkoutOrderId`",
