meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/identity/auth/login
  body: json
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.accessToken) {
    bru.setVar("accessToken", body.data.accessToken);
  }
}
