meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{identityBaseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@gmail.com",
    "password": "12345678"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.accessToken) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
  }
}

tests {
  test("login returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("access token exists", function () {
    expect(res.body.data.accessToken).to.not.be.empty;
  });
}
