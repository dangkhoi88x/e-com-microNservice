meta {
  name: 05 Update Category
  type: http
  seq: 5
}

put {
  url: {{productBaseUrl}}/api/v1/categories/{{categoryId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{updatedCategoryName}}",
    "description": "Updated by Bruno API test"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setEnvVar("categorySlug", res.body.data.slug);
  }
}

tests {
  test("status is 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("category is updated", function () {
    expect(res.body.data.name).to.equal(bru.getEnvVar("updatedCategoryName"));
    expect(res.body.data.slug).to.include("laptop-gaming-updated");
  });
}
