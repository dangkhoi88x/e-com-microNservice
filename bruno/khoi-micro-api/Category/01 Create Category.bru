meta {
  name: 01 Create Category
  type: http
  seq: 1
}

post {
  url: {{productBaseUrl}}/api/v1/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  const suffix = Date.now();
  bru.setEnvVar("categoryName", `Laptop Gaming Test ${suffix}`);
  bru.setEnvVar("updatedCategoryName", `Laptop Gaming Updated ${suffix}`);
}

body:json {
  {
    "name": "{{categoryName}}",
    "description": "Category used for Bruno API testing"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setEnvVar("categoryId", res.body.data.id);
    bru.setEnvVar("categorySlug", res.body.data.slug);
  }
}

tests {
  test("status is 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("response contains category data", function () {
    expect(res.body.data.id).to.not.be.empty;
    expect(res.body.data.name).to.equal(bru.getEnvVar("categoryName"));
    expect(res.body.data.slug).to.include("laptop-gaming-test");
  });
}
