meta {
  name: 06 Create Duplicate Category
  type: http
  seq: 6
}

post {
  url: {{productBaseUrl}}/api/v1/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{updatedCategoryName}}",
    "description": "This request should fail because name already exists"
  }
}

tests {
  test("status is 400 Bad Request", function () {
    expect(res.status).to.equal(400);
  });

  test("message says category already existed", function () {
    expect(res.body.message).to.equal("Category already existed");
  });
}
