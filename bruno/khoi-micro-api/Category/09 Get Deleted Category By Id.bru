meta {
  name: 09 Get Deleted Category By Id
  type: http
  seq: 9
}

get {
  url: {{productBaseUrl}}/api/v1/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 404 Not Found", function () {
    expect(res.status).to.equal(404);
  });

  test("message says category not found", function () {
    expect(res.body.message).to.equal("Category not found");
  });
}
