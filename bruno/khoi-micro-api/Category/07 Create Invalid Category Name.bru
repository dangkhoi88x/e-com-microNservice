meta {
  name: 07 Create Invalid Category Name
  type: http
  seq: 7
}

post {
  url: {{productBaseUrl}}/api/v1/categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "!!!",
    "description": "This request should fail because slug becomes blank"
  }
}

tests {
  test("status is 400 Bad Request", function () {
    expect(res.status).to.equal(400);
  });

  test("message says category name is invalid", function () {
    expect(res.body.message).to.equal("Category name is invalid");
  });
}
