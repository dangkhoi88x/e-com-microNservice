meta {
  name: 04 Get Category By Slug
  type: http
  seq: 4
}

get {
  url: {{productBaseUrl}}/api/v1/categories/slug/{{categorySlug}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns selected category slug", function () {
    expect(res.body.data.slug).to.equal(bru.getEnvVar("categorySlug"));
  });
}
